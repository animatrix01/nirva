# NIRVA environment template — copy to .env and fill real values. NEVER commit .env.

DATABASE_URL=postgresql://nirva:nirva@postgres:5432/nirva
QDRANT_URL=http://qdrant:6333
MODEL_BASE_URL=http://ollama:11434/v1
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_PATH=/data/nirva-storage

# Optional (proposal 2026-08-29): startup refuses the default JWT secret unless true.
# Set to 1 only for the offline demo profile.
# DEMO_MODE=1
